---
extends: default
rules:
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 0
  comments-indentation: false
  comments:
    min-spaces-from-content: 1
  line-length:
    max: 120
  octal-values:
    forbid-explicit-octal: true
    forbid-implicit-octal: true
  quoted-strings:
    quote-type: double
    required: only-when-needed
