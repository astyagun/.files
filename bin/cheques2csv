#!/usr/bin/env bash

# Обработка сразу нескольких чеков

for cheque in *.txt; do
  echo --------------------------------------------------------------------------------
  echo "$cheque..."
  if cheque2csv "$cheque"; then
    echo Готово
  else
    echo Ошибка!
    mkdir -p Err
    mv "$cheque" Err/
  fi
  echo
done

if [ "$(find . -maxdepth 1 -name '*.csv' -print | wc -l)" -gt 1 ]; then
  echo "Объединение CSV-файлов..."
  concatcsv
fi
