#!/usr/bin/env bash
# mdb-find — look up one title by IMDb ID (tconst).
# Rails-style find: exactly one record, error if not found.
#
# Usage: mdb-find tt0111161 [--fields a,b,c] [--format jsonl|table]
#   --fields a,b,c       subset of: tconst,type,is_adult,primary_title,
#                        original_title,start_year,end_year,runtime_minutes,
#                        avg_rating,num_votes,genres,series_stats
#   --format jsonl|table default: table on a terminal, jsonl when piped
set -euo pipefail
source "$(dirname "$0")/_mdb_common"

id="" fields="" format=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) mdb_help; exit 0 ;;
    --fields) fields=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --format) format=$(mdb_val "$1" "${2-}"); shift 2 ;;
    tt*)      [[ -z "$id" ]] || { echo "extra arg: $1" >&2; exit 64; }; id="$1"; shift ;;
    *)        echo "unknown arg: $1" >&2; exit 64 ;;
  esac
done
[[ -n "$id" ]] || { echo "usage: mdb-find <tconst> [--fields a,b,c] [--format jsonl|table]" >&2; exit 64; }
[[ "$id" =~ ^tt[0-9]+$ ]] || { echo "bad tconst: $id" >&2; exit 65; }
mdb_require_catalog
mdb_pick_format

if [[ -z "$fields" ]]; then
  fields=tconst,type,primary_title,original_title,start_year,end_year,runtime_minutes,avg_rating,num_votes,genres,series_stats
fi
IFS=',' read -ra fs <<< "$fields"
mdb_build_fields "${fs[@]}"

# not found must mean "no such title", not "catalog unreadable": run sqlite
# outside a pipe so a DB error aborts here instead of masquerading as a miss.
found=$(sqlite3 "$MDB_DB" "SELECT 1 FROM titles t WHERE t.tconst = '$id';")
[[ -n "$found" ]] || { echo "not found: $id" >&2; exit 1; }

if [[ "$format" == table ]]; then
  sqlite3 -header -column "$MDB_DB" "
SELECT $MDB_TABLE_COLS
FROM titles t WHERE t.tconst = '$id';" | sed 's/[[:space:]]*$//'
else
  sqlite3 -list "$MDB_DB" "
SELECT json_object($MDB_JSON_ARGS)
FROM titles t WHERE t.tconst = '$id';"
fi
