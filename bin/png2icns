#!/usr/bin/env bash

# Ideal source image size is 1024x1024

SOURCE_PNG="$1"
if [[ "${SOURCE_PNG##*.}" != "png" ]]; then
  echo "Source file must be a .png"
  exit 1
fi
if [ ! -f "$SOURCE_PNG" ]; then
  echo "Usage: $0 <source.png>"
  exit 1
fi

SOURCE_FILE_NAME=$(basename "$SOURCE_PNG" .png)
OUTPUT_DIRECTORY=$(dirname "$SOURCE_PNG")
ICONSET_PATH="$OUTPUT_DIRECTORY/$SOURCE_FILE_NAME.iconset"

rm -rf "$ICONSET_PATH"
mkdir -p "$ICONSET_PATH"

for size in 16 32 128 256 512; do
  sips -z $size $size -s format png "$SOURCE_PNG" --out "$ICONSET_PATH/icon_${size}x${size}.png" > /dev/null
  sips -z $((size * 2)) $((size * 2)) -s format png "$SOURCE_PNG" --out "$ICONSET_PATH/icon_${size}x${size}@2x.png" > /dev/null
done

iconutil --convert icns "$ICONSET_PATH"
