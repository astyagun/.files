#!/usr/bin/env zsh
# Zsh, because macOS bash is old and doesn't support arrays

# Run Pi agent in a Docker container as a sandbox
# Mount ".git" directory in read-only mode to prevent accidental destructive changes to the repository
# Mount git ignored files and directories to prevent accidental modifications

# Pi containerization docs: https://pi.dev/docs/latest/containerization

workspace_read_only=":ro"
if [[ $(dirname $PWD) == ~/Code ]] || [[ $PWD == ~/.files ]] || [[ $PWD == ~/.vim ]]; then
  # Allow writing to FS only in code projects directories
  workspace_read_only=""
fi

tty=""
if [ -t 0 ]; then
  # Can't pass --tty if STDIN is present
  tty="--tty"
fi

# Global config: git ignored paths excluded from masking, one path per line ('~' or absolute, no bare relative
# paths), '#' starts a comment. Explicit paths on purpose: a bare relative name could unexpectedly match the same
# named directory in different projects.
# Kept outside projects and ~/.pi/agent on purpose: the sandbox must not see or tamper with it.
pi_visible_file="$HOME/.files/pi/visible"
pi_visible=()
if [ -f "$pi_visible_file" ]; then
  while read -r line; do
    line=${line%/}
    [ -z "$line" ] && continue
    if [[ "$line" == '~'* ]]; then
      line=${line/#\~/$HOME}
    elif [[ "$line" != /* ]]; then
      echo "$0: error: $pi_visible_file: not an absolute or ~ path: $line" >&2
      exit 1
    fi
    pi_visible+=("$line")
  done <<< "$(sed -E 's/^[[:space:]]*#.*//; s/[[:space:]]+#.*//; s/[[:space:]]*$//' "$pi_visible_file")"
fi

# Global config: custom per-project read-only mounts. '|'-separated fields: project directory, host path, optional
# mount name. Mounts appear at /mnt/<basename of host path>, or /mnt/<custom name> with the third field. '~' or
# absolute paths, '#' starts a comment, spaces in paths are fine, '|' must not appear in paths. Mounted outside
# /workspace on purpose: a mount can't shadow workspace content.
pi_mounts_file="$HOME/.files/pi/mounts"
pi_extra_mounts=()
if [ -f "$pi_mounts_file" ]; then
  while read -r line; do
    [ -z "$line" ] && continue
    fields=("${(@s:|:)line}")
    if (( ${#fields} < 2 || ${#fields} > 3 )); then
      echo "$0: error: $pi_mounts_file: expected 'project | host path [| mount name]': $line" >&2
      exit 1
    fi
    proj=${fields[1]}
    src=${fields[2]}
    dest=${fields[3]}
    proj=${proj/#\~/$HOME}
    src=${src/#\~/$HOME}
    if [[ "$proj" != /* || "$src" != /* ]]; then
      echo "$0: error: $pi_mounts_file: not an absolute or ~ path: $line" >&2
      exit 1
    fi
    if [[ "$proj" != "$PWD" ]]; then
      # Don't check source existence for other projects: e.g. an unmounted external drive shouldn't break this one
      continue
    fi
    if [ ! -e "$src" ]; then
      echo "$0: error: $pi_mounts_file: source doesn't exist: $src" >&2
      exit 1
    fi
    [ -z "$dest" ] && dest=${src:t}
    if [[ -z "$dest" || "$dest" == /* || "$dest" == *..* ]]; then
      echo "$0: error: $pi_mounts_file: bad mount name: $dest" >&2
      exit 1
    fi
    pi_extra_mounts+=("-v" "$src:/mnt/$dest:ro")
  done <<< "$(sed -E 's/^[[:space:]]*#.*//; s/[[:space:]]+#.*//; s/[[:space:]]*\|/|/g; s/\|[[:space:]]*/|/g; s/[[:space:]]+$//' "$pi_mounts_file")"
fi

git_volume=()
git_ignores_volumes=()
if [ -d '.git' ]; then
  # Read only, so that LLM can't `git push -f` or rebase accidentally
  git_volume=("-v" "$PWD/.git:/workspace/.git:ro")
  if [ ! -f "$HOME/.gitignore" ]; then
    echo "$0: error: $HOME/.gitignore not found (mounted as gitignore_global in the container)" >&2
    exit 1
  fi
  git_ignores_volumes=("-v" "$HOME/.gitignore:/home/pi/.gitignore_global:ro")

  # Mount empty anonymous volumes for each git ignore, so that LLM can't modify or delete these untracked files or
  # directories. NUL-delimited porcelain output is safe for paths with spaces and special characters;
  # core.quotePath=false stops git from quoting non-ASCII paths.
  local git_status
  if ! git_status=$(git -c core.quotePath=false status --ignored --porcelain -z); then
    echo "$0: error: git status --ignored failed in $PWD" >&2
    exit 1
  fi

  for status_entry in "${(@0)git_status}"; do
    [[ "$status_entry" == '\!\! '* ]] || continue
    git_ignore=${status_entry:3}
    git_ignore=${git_ignore%/}
    case "$git_ignore" in
      # Not worth masking
      .DS_Store|*/.DS_Store|undodir/*) continue ;;
    esac
    if (( ${pi_visible[(Ie)$PWD/$git_ignore]} )); then
      # Excluded from git ignore masking: no bind mount, inherits workspace mount permissions
      continue
    elif [ -f "$git_ignore" ]; then
      # If it's a file, mount an empty file on top of it
      git_ignores_volumes+=("-v" "/dev/null:/workspace/${git_ignore}:ro")
    else
      # If it's a directory, mount an empty anonymous volume directory on top of it
      git_ignores_volumes+=("-v" "/workspace/$git_ignore")
    fi
  done
fi

container_name=${PWD##*/}
container_name=${container_name//[^a-zA-Z0-9_-]/_}
# Hash of the full path: different projects can share a directory basename, which would otherwise collide
container_name="pi_agent-${container_name}-$(print -rn -- "$PWD" | cksum | cut -d' ' -f1)"

docker run --rm --interactive \
  --name "$container_name" \
  ${tty} \
  -e PI_SKIP_VERSION_CHECK=true \
  -e PI_OFFLINE=true \
  -e PI_TELEMETRY=false \
  -v "$PWD:/workspace$workspace_read_only" \
  -v "$HOME/.pi/agent:/home/pi/.pi/agent" \
  "${git_volume[@]}" \
  "${git_ignores_volumes[@]}" \
  "${pi_extra_mounts[@]}" \
  --add-host=host.docker.internal:host-gateway \
  pi_agent "$@"
