#!/usr/bin/env bash
# mdb-where — filter the catalog, one JSON object per line (JSONL).
# Rows have the same shape as mdb-find output.
#
# Usage: mdb-where [filters] [ordering] [paging]
#   --type movie,tvSeries        title types; comma list = any of (OR)
#   --genre Horror,Comedy        one flag, comma list = ALL of (AND)
#   --genre Horror --genre Sci-Fi  repeated flags = ANY of (OR)
#                                (case-insensitive)
#   --year N                     airing in year N (series may span it)
#   --year-from N                still airing at or after N
#   --year-to N                  started at or before N
#   (--year is a point query; not with --year-from/-to)
#   --min-rating R               avg_rating >= R
#   --min-votes N                num_votes >= N
#   --title TEXT                 case-insensitive substring of primary_title
#   --sort rating|votes|year     default: rating
#   --order desc|asc             default: desc
#   --limit N                    default: 20
#   --offset N                   default: 0
#   --fields a,b,c               subset of: tconst,type,is_adult,primary_title,
#                                original_title,start_year,end_year,
#                                runtime_minutes,avg_rating,num_votes,
#                                genres,series_stats
#   --format jsonl|table         default: table on a terminal, jsonl when piped
set -euo pipefail
source "$(dirname "$0")/_mdb_common"

types=""
declare -a genre_groups=()
year_exact="" year_from="" year_to="" min_rating="" min_votes="" title=""
sort=rating order=desc limit=20 offset=0
fields="" format=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) mdb_help; exit 0 ;;
    --type)       types="${types:+$types,}$(mdb_val "$1" "${2-}")"; shift 2 ;;
    --genre)      genre_groups+=("$(mdb_val "$1" "${2-}")"); shift 2 ;;
    --year)       year_exact=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --year-from)  year_from=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --year-to)    year_to=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --min-rating) min_rating=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --min-votes)  min_votes=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --title)      title=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --sort)       sort=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --order)      order=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --limit)      limit=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --offset)     offset=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --fields)     fields=$(mdb_val "$1" "${2-}"); shift 2 ;;
    --format)     format=$(mdb_val "$1" "${2-}"); shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 64 ;;
  esac
done

for v in "$year_exact" "$year_from" "$year_to" "$min_votes" "$limit" "$offset"; do
  [[ -z "$v" || "$v" =~ ^[0-9]+$ ]] || { echo "not a number: $v" >&2; exit 65; }
done
[[ -z "$year_exact" || -z "$year_from$year_to" ]] || { echo "--year is a single year; use --year-from/--year-to for a range, not both" >&2; exit 65; }
[[ -z "$min_rating" || "$min_rating" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "not a number: $min_rating" >&2; exit 65; }
case "$sort"  in rating) sort=avg_rating;; votes) sort=num_votes;; year) sort=start_year;; *) echo "bad --sort: $sort" >&2; exit 65;; esac
case "$order" in desc|asc) ;; *) echo "bad --order: $order" >&2; exit 65;; esac
mdb_require_catalog
mdb_pick_format

# Field selection: name -> JSON fragment / table column expression.
if [[ -z "$fields" ]]; then
  if [[ "$format" == table ]]; then
    fields=tconst,type,primary_title,start_year,avg_rating,num_votes,genres,series_stats
  else
    fields=tconst,type,primary_title,original_title,start_year,end_year,runtime_minutes,avg_rating,num_votes,genres,series_stats
  fi
fi
IFS=',' read -ra fs <<< "$fields"
mdb_build_fields "${fs[@]}"

where=()

if [[ -n "$types" ]]; then
  in_list=""
  IFS=',' read -ra ts <<< "$types"
  for t in "${ts[@]}"; do
    case "$t" in movie|tvSeries|tvMiniSeries|tvMovie) ;; *) echo "bad --type: $t (known: movie,tvSeries,tvMiniSeries,tvMovie)" >&2; exit 65 ;; esac
    in_list+="'$(sq "$t")',"
  done
  where+=("t.type IN (${in_list%,})")
fi

# one group per --genre flag: ALL genres in a group must match (AND);
# groups are OR-ed together.
genre_cond=""
for group in "${genre_groups[@]+"${genre_groups[@]}"}"; do
  in_list=""
  IFS=',' read -ra gs <<< "$group"
  for i in "${!gs[@]}"; do gs[i]=$(trim "${gs[i]}"); done   # "Horror, Comedy" must match
  for g in "${gs[@]}"; do in_list+="'$(sq "$g")',"; done
  # case-folded distinct genres; an all-empty group (e.g. ",") is a usage error
  n=$(printf '%s\n' "${gs[@]}" | tr '[:upper:]' '[:lower:]' | sort -u | grep -c . || true)
  [[ "$n" -gt 0 ]] || { echo "empty --genre group: $group" >&2; exit 65; }
  cond="(SELECT 1 FROM genres_titles gt JOIN genres g ON g.id = gt.genre_id
           WHERE gt.title_id = t.tconst
             AND g.name COLLATE NOCASE IN (${in_list%,})
           GROUP BY gt.title_id HAVING COUNT(DISTINCT g.name COLLATE NOCASE) = $n)"
  genre_cond+="${genre_cond:+ OR }$cond"
done
[[ -n "$genre_cond" ]] && where+=("($genre_cond)")

# Titles are year intervals: series run start_year..end_year (NULL end =
# still airing); movies are points. Year filters select overlapping intervals.
ongoing_end="(CASE WHEN t.type IN ('tvSeries','tvMiniSeries') THEN COALESCE(t.end_year, 9999) ELSE t.start_year END)"
[[ -n "$year_exact" ]] && where+=("t.start_year <= $year_exact AND $ongoing_end >= $year_exact")
[[ -n "$year_from"  ]] && where+=("$ongoing_end >= $year_from")
[[ -n "$year_to"    ]] && where+=("t.start_year <= $year_to")
[[ -n "$min_rating" ]] && where+=("t.avg_rating >= $min_rating")
[[ -n "$min_votes"  ]] && where+=("t.num_votes >= $min_votes")

if [[ -n "$title" ]]; then
  esc=${title//\\/\\\\}; esc=${esc//\%/\\%}; esc=${esc//_/\\_}
  where+=("t.primary_title LIKE '%$(sq "$esc")%' ESCAPE '\\'")
fi

sql_where=""
if [[ ${#where[@]} -gt 0 ]]; then
  joined=""
  for c in "${where[@]}"; do joined+="${joined:+ AND }$c"; done
  sql_where="WHERE $joined"
fi

if [[ "$format" == table ]]; then
  sqlite3 -header -column "$MDB_DB" "
SELECT $MDB_TABLE_COLS
FROM titles t
$sql_where
ORDER BY $sort $order, t.tconst
LIMIT $limit OFFSET $offset;" | sed 's/[[:space:]]*$//'
else
  sqlite3 -list "$MDB_DB" "
SELECT json_object($MDB_JSON_ARGS)
FROM titles t
$sql_where
ORDER BY $sort $order, t.tconst
LIMIT $limit OFFSET $offset;"
fi
