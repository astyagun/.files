#!/usr/bin/env bash

# List Ruby gems, that are not a dependency of any other gem (analog of `brew leaves`)
#
# ALso excludes gems from stdlib. But assumes that the OS is macOS with Homebrew installed Ruby for this.

GEMS=$(gem list -l | sed 's/ (.*//' | sort)
DEPS=$(echo "$GEMS" | xargs -n1 gem dependency -l --pipe | sed 's/ --version.*//' | sort -u)
LEAVES=$(comm -23 <(echo "$GEMS") <(echo "$DEPS"))

while read -r gem; do
  if ! gem info "$gem" | grep -q Cellar; then
    echo "$gem"
  fi
done <<< "$LEAVES"
